# ---- Claude ----
ANTHROPIC_API_KEY=            # leave empty to run in offline MOCK mode
CLAUDE_MODEL=claude-sonnet-5-5

# ---- Instagram Graph API (Business Discovery) ----
IG_ACCESS_TOKEN=              # leave empty to use data/mock_profiles.json
IG_USER_ID=                   # your IG Business/Creator account id

# ---- Gmail ----
GMAIL_MODE=mock               # mock | live
SENDER_NAME=Your Name
SENDER_TITLE=Partnerships Associate
SENDER_COMPANY=GlowLeaf Naturals
SENDER_ADDRESS=Your postal address here (required by CAN-SPAM style rules)

# ---- Storage ----
STORE_BACKEND=csv             # csv | sheets
GOOGLE_SHEET_NAME=Influencer CRM

# ---- Sending rules ----
DAILY_SEND_LIMIT=20
MIN_SCORE=60
FOLLOWUP1_DAYS=4              # brief: 3-5 days
FOLLOWUP2_DAYS=6              # brief: 5-7 days after follow-up 1
